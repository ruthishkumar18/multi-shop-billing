# =============================================================================
# Database and Flask Configuration
# Configure these variables in your local .env file
# =============================================================================

# Flask Secret Key for Session Encryption
SECRET_KEY=dev-secret-key-replace-with-random-hex-string

# MySQL Connection Details (Default local setup: root, no password, localhost)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=billing_db
DB_PORT=3306

# App Server Port
PORT=5000
